# ---- App ----
APP_ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=info
# Set true only when running behind a trusted reverse proxy (audit logs then use X-Forwarded-For).
TRUST_PROXY=false

# ---- Database (PostgreSQL 13+) ----
DATABASE_URL=postgres://dms:dms@localhost:5432/dms?sslmode=disable
# Apply migrations/*.up.sql automatically at start-up.
MIGRATE_ON_START=true

# ---- Admin API (/admin/v1) ----
# Bearer token for onboarding applications. Leave empty to disable the admin API.
# Generate one with:  openssl rand -hex 32
ADMIN_TOKEN=change-me-to-a-long-random-value

# ---- Upload policy ----
MAX_UPLOAD_MB=25
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,gif,webp,txt,csv,docx,xlsx,pptx

# ---- Storage: local | s3 ----
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./data/storage

# S3 / MinIO (when STORAGE_DRIVER=s3). Endpoint is host:port without scheme.
S3_ENDPOINT=localhost:9000
S3_BUCKET=dms
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_USE_SSL=false
S3_CREATE_BUCKET=false

# ---- Malware scanner: disabled | noop ----
# disabled: files stay PENDING (cannot be downloaded) until a real scanner is plugged in.
# noop:     DEV ONLY - marks every file CLEAN without scanning.
SCANNER_DRIVER=noop
SCAN_POLL_INTERVAL=5s
SCAN_BATCH_SIZE=10
SCAN_TIMEOUT=2m
SCAN_MAX_ATTEMPTS=3
SCAN_STALE_AFTER=10m

SHUTDOWN_TIMEOUT=20s
